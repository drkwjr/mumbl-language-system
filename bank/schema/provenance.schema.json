{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mumbl-bank/provenance",
  "title": "Provenance + verification (on every bank record)",
  "type": "object",
  "required": ["source", "verification"],
  "properties": {
    "source": { "type": "string", "description": "source_id in sources/inventory.jsonl" },
    "license": { "type": "string" },
    "method": { "type": "string", "description": "how this record was derived (e.g. shared-gloss)" },
    "verification": {
      "type": "string",
      "enum": ["unverified", "auto", "auto-gloss", "native-verified"],
      "description": "verify-not-trust tier; only auto/native-verified are voiced to learners"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "as_of": { "type": "string", "description": "ISO date" }
  }
}
