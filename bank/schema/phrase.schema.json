{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mumbl-bank/phrase",
  "title": "Phrase (the verified phrase bank the brain produces from)",
  "type": "object",
  "required": ["id", "lang", "text_aka", "text_en", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "lang": { "type": "string", "description": "ISO 639-3" },
    "text_aka": { "type": "string", "description": "the phrase in the target language" },
    "text_en": { "type": "string", "description": "English meaning" },
    "topic": { "type": ["string", "null"], "description": "scenario/topic tag (Shopping, Numbers, ...)" },
    "register": { "type": ["string", "null"], "enum": ["formal", "informal", "polite", "casual", null] },
    "pronunciation_hint": { "type": ["string", "null"] },
    "provenance": { "$ref": "provenance.schema.json" }
  }
}
